<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CommandCapture.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="720"
        x:Class="CommandCapture.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Command Capture"
        Width="960"
        Height="720"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="Command Capture" />
            <TextBlock Classes="caption"
                       Text="Speak a capture phrase or press Capture image. Both save the current preview." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,6,320" ColumnSpacing="0">
            <Grid Grid.Column="0" MinWidth="280" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="12">
                <Border Padding="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemAccentBrush}"
                        CornerRadius="8">
                    <Image Source="{Binding Preview, FallbackValue={x:Null}}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Preview pattern" />
                </Border>

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Classes="emphasis"
                               Text="{Binding MicrophoneLevel, StringFormat='Microphone {0:P0}', FallbackValue='Microphone 0%'}" />
                    <ProgressBar Classes="meter"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding MicrophoneLevel, FallbackValue=0}"
                                 AutomationProperties.Name="Microphone level" />
                    <TextBlock Classes="caption" Text="{Binding OverrunText, FallbackValue=''}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="12" HorizontalAlignment="Center">
                    <Button Classes="command"
                            Content="Download keyword model"
                            Command="{Binding DownloadModelCommand}"
                            IsVisible="{Binding ShowDownload, FallbackValue=False}"
                            HorizontalAlignment="Center"
                            MinWidth="280"
                            AutomationProperties.Name="Download keyword model" />
                    <Button Classes="listen accent"
                            Content="Listen"
                            Command="{Binding ListenCommand}"
                            IsVisible="{Binding ShowListen, FallbackValue=False}"
                            AutomationProperties.Name="Listen for voice commands"
                            AutomationProperties.HelpText="Listens for a capture phrase and saves the current preview." />
                    <Button Classes="listen"
                            Content="Stop listening"
                            Command="{Binding StopListeningCommand}"
                            IsVisible="{Binding ShowStopListen, FallbackValue=False}"
                            AutomationProperties.Name="Stop listening" />
                    <Button Classes="command"
                            Content="Capture image"
                            Command="{Binding CaptureCommand}"
                            HorizontalAlignment="Center"
                            MinWidth="280"
                            AutomationProperties.Name="Capture image"
                            AutomationProperties.HelpText="Saves the current preview as a PNG." />
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="4">
                    <TextBlock Classes="caption" Text="Stills folder" />
                    <SelectableTextBlock Classes="body"
                                         Text="{Binding StillFolderText, FallbackValue=''}"
                                         AutomationProperties.Name="Stills folder" />
                    <TextBlock Classes="caption" Text="Last still" />
                    <SelectableTextBlock Classes="body"
                                         Text="{Binding LastStillText, FallbackValue=''}"
                                         AutomationProperties.Name="Last still" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          AutomationProperties.Name="Resize preview" />

            <Grid Grid.Column="2" MinWidth="260" Margin="16,0,0,0" RowDefinitions="*,Auto" RowSpacing="16">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Classes="emphasis" Text="Heard" />
                    <TextBlock Grid.Row="1"
                               Classes="caption"
                               Text="Matches, misses, cooldowns, and busy drops." />
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding PhraseLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PhraseLogRow">
                                    <StackPanel Spacing="2" Margin="0,0,0,12">
                                        <TextBlock Classes="caption" Text="{Binding Time, FallbackValue=''}" />
                                        <TextBlock Classes="emphasis" Text="{Binding Phrase, FallbackValue=''}" />
                                        <TextBlock Classes="caption" Text="{Binding Keyword, FallbackValue=''}" />
                                        <TextBlock Classes="body" Text="{Binding Outcome, FallbackValue=''}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBlock Classes="emphasis" Text="Commands" />
                    <TextBlock Classes="caption" Text="Each phrase saves the current preview." />
                    <ScrollViewer MaxHeight="160">
                        <ItemsControl ItemsSource="{Binding Commands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CatalogPhraseRow">
                                    <TextBlock Classes="body"
                                               Margin="0,0,0,8"
                                               Text="{Binding Phrase, FallbackValue=''}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox Text="{Binding NewPhrase, Mode=TwoWay, FallbackValue=''}"
                             PlaceholderText="New capture phrase"
                             MinHeight="44"
                             AutomationProperties.Name="New capture phrase" />
                    <Button Classes="command"
                            Content="Add phrase"
                            Command="{Binding AddPhraseCommand}"
                            AutomationProperties.Name="Add phrase"
                            AutomationProperties.HelpText="Adds a phrase that saves the current preview." />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Classes="body"
                   Text="{Binding Status, FallbackValue=''}"
                   AutomationProperties.Name="Status" />
    </Grid>
</Window>
